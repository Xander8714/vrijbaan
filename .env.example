NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Voor scripts/poll-availability.ts (Telegram-notificaties bij nieuwe sloten).
# Zonder deze twee wordt een nieuw slot alleen gelogd, niet verstuurd.
# Bot aanmaken via @BotFather; chat_id opvragen via api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Komma-gescheiden beheeradressen voor /beheer/social-media.
SOCIAL_MEDIA_ADMIN_EMAILS=info@devrijebaan.nl

# Organische Meta Graph API-koppeling voor de socialmediaworker.
# Gebruik de System User-token; de worker leidt per run zelf een Page Access
# Token af voor Facebook-carrousels. Nooit NEXT_PUBLIC_ gebruiken.
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
SOCIAL_MEDIA_BUCKET=social-media
SOCIAL_MEDIA_WORKER_ID=vrijebaan-vps
